{
  "ConnectionStrings": {
    "MartenEventStore": "Host=localhost;Port=5432;Database=cosmos.datosreferenciadb;Username=Cosmos.DatosReferenciaUser;Password=Cosmos.DatosReferenciaPassword;",
    "RabbitMQ": "amqp://localhost:5672"
  },
  "OpenTelemetryEndpoint": "http://localhost:4317",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "System": "Warning",
        "Marten": "Information",
        "Wolverine": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "ApplicationContext": "Cosmos.DatosReferencia.Comandos.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
